<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do ícone adaptativo: o verde da própria arte, para a placa do
     emblema não ficar a flutuar numa moldura de outra cor. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#22A85D"
        android:centerColor="#0C7C41"
        android:endColor="#01682F"
        android:type="linear" />
</shape>
