<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: o arranque é do sistema e não se pode desligar — mostra o
     ícone da app sobre esta cor. Fica o fundo da app, para a passagem ao
     primeiro ecrã não se notar. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/fundo_arranque</item>
    </style>
</resources>
