<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: os links partilhados de notícias e bilhetes abrem a
	     app (lib/core/links.dart). O site oficial tem de servir
	     /.well-known/apple-app-site-association com o Team ID, que só existe
	     depois de criada a conta Apple Developer. A capacidade "Associated
	     Domains" tem de estar activa no App ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:leoesdeportosalvo.pt</string>
		<string>applinks:www.leoesdeportosalvo.pt</string>
		<string>applinks:new.leoesdeportosalvo.pt</string>
	</array>
</dict>
</plist>
